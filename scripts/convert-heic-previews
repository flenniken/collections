#!/bin/bash

# Convert HEIC stills to jpg, keeping the existing basename.
#
# After standard-rename, files look like c25-1-p.HEIC. This script
# writes c25-1-p.jpg and removes the HEIC.
#
# Keeps EXIF/GPS. Strips the ICC color profile so the maker sees JPEG
# not MPO. heif-convert already rotates pixels to the display
# orientation; Orientation is reset to 1 so viewers do not rotate again.
#
# Usage:
#   scripts/convert-heic-previews tmp/cN
#
# Run from the docker container (or macOS with sips). Removes each
# .heic after its .jpg is created (or already exists).

set -euo pipefail

previewMinDim=933
jpegQuality=80

folder="${1:-.}"

if [[ ! -d "$folder" ]]; then
  echo "Error: not a directory: $folder"
  exit 1
fi

if command -v heif-convert >/dev/null 2>&1; then
  convertTool=heif-convert
elif command -v sips >/dev/null 2>&1; then
  convertTool=sips
else
  echo "Error: heif-convert not found. Rebuild the docker container (see docs/build.md)."
  exit 1
fi

shopt -s nullglob nocaseglob

heic_files=("$folder"/*.heic)
if [[ ${#heic_files[@]} -eq 0 ]]; then
  echo "No .heic files in $folder"
  exit 0
fi

finalize_jpeg() {
  local jpeg="$1"
  python3 - "$jpeg" "$jpegQuality" <<'EOF'
from PIL import Image
import sys

path = sys.argv[1]
quality = int(sys.argv[2])

# IFDs to load so tobytes() keeps camera EXIF and GPS.
exifIfd = 0x8769
gpsIfd = 0x8825
interopIfd = 0xA005
orientationTag = 274

with Image.open(path) as img:
    exif = img.getexif()
    if len(exif) or img.info.get("exif"):
        for ifd_id in (exifIfd, gpsIfd, interopIfd):
            try:
                exif.get_ifd(ifd_id)
            except Exception:
                pass
        # Pixels are already display-oriented; do not rotate again.
        exif[orientationTag] = 1
        exif_bytes = exif.tobytes()
    else:
        exif_bytes = None

    rgb = img.convert("RGB")
    save_kwargs = {
        "format": "JPEG",
        "quality": quality,
        "optimize": True,
    }
    if exif_bytes:
        save_kwargs["exif"] = exif_bytes
    rgb.save(path, **save_kwargs)
EOF
}

jpeg_dimensions() {
  local jpeg="$1"
  python3 - "$jpeg" <<'EOF'
from PIL import Image
import sys

with Image.open(sys.argv[1]) as img:
    print(img.size[0], img.size[1])
EOF
}

convert_heic() {
  local heic="$1"
  local base="${heic%.*}"
  local out="${base}.jpg"

  if [[ -e "$out" ]]; then
    echo "skip (exists): $(basename "$out")"
    rm "$heic"
    echo "remove: $(basename "$heic")"
    return 0
  fi

  echo "convert: $(basename "$heic") -> $(basename "$out")"
  if [[ "$convertTool" == "heif-convert" ]]; then
    heif-convert -q "$jpegQuality" "$heic" "$out"
    finalize_jpeg "$out"
  else
    sips -s format jpeg -s formatOptions "$jpegQuality" \
      --deleteColorManagementProperties \
      "$heic" --out "$out" >/dev/null
  fi

  read -r width height <<< "$(jpeg_dimensions "$out")"
  if [[ "$width" -lt "$previewMinDim" || "$height" -lt "$previewMinDim" ]]; then
    echo "warning: $(basename "$out") is ${width}x${height}; maker requires >= ${previewMinDim} in both dimensions"
  fi

  rm "$heic"
  echo "remove: $(basename "$heic")"
}

for heic in "${heic_files[@]}"; do
  convert_heic "$heic"
done

echo "done"
