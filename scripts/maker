  def test_mergeCinfo_unchanged(self):
    existing = {
      "title": "Santa Fe",
      "indexDescription": "Index text",
      "description": "Thumbnails text",
      "cNum": 4,
      "posted": "2025-06-22",
      "images": [{
        "description": "Deck photo",
        "iPreview": "c4-1-p.jpg",
        "iThumbnail": "c4-1-t.jpg",
        "width": 4032,
        "height": 3024,
        "size": 100,
        "sizet": 50,
        "location": "35.6,-105.9",
        "taken": "2025-06-21T18:25:30",
      }],
      "zoomPoints": {"430x933": [{"scale": 1, "tx": 0, "ty": 0}]},
    }
    fresh = {
      "title": "",
      "indexDescription": "",
      "description": "",
      "cNum": 4,
      "posted": "",
      "images": [{
        "description": "",
        "iPreview": "c4-1-p.jpg",
        "iThumbnail": "c4-1-t.jpg",
        "width": 4032,
        "height": 3024,
        "size": 100,
        "sizet": 50,
      }],
      "building": True,
      "zoomPoints": {},
    }
    merged = mergeCinfo(fresh, existing)
    gotExpected(merged, existing)
    gotExpected("building" in merged, False)

  def test_mergeCinfo_updates_size_keeps_description(self):
    existing = {
      "title": "Santa Fe",
      "cNum": 4,
      "images": [{
        "description": "Deck photo",
        "iPreview": "c4-1-p.jpg",
        "iThumbnail": "c4-1-t.jpg",
        "width": 100,
        "height": 100,
        "size": 1,
        "sizet": 1,
      }],
    }
    fresh = {
      "title": "",
      "cNum": 4,
      "images": [{
        "description": "",
        "iPreview": "c4-1-p.jpg",
        "iThumbnail": "c4-1-t.jpg",
        "width": 4032,
        "height": 3024,
        "size": 3191993,
        "sizet": 119055,
      }],
      "building": True,
      "zoomPoints": {},
    }
    merged = mergeCinfo(fresh, existing)
    image = merged["images"][0]
    gotExpected(merged["title"], "Santa Fe")
    gotExpected(image["description"], "Deck photo")
    gotExpected(image["width"], 4032)
    gotExpected(image["height"], 3024)
    gotExpected(image["size"], 3191993)
    gotExpected(image["sizet"], 119055)

  def test_mergeCinfo_adds_live_video(self):
    existing = {
      "title": "Santa Fe",
      "cNum": 4,
      "images": [{
        "description": "Live photo of the plaza",
        "iPreview": "c4-5-p.jpg",
        "iThumbnail": "c4-5-t.jpg",
        "width": 4032,
        "height": 3024,
        "size": 10,
        "sizet": 5,
      }],
    }
    fresh = {
      "title": "",
      "cNum": 4,
      "images": [{
        "description": "",
        "iPreview": "c4-5-p.jpg",
        "iThumbnail": "c4-5-t.jpg",
        "width": 4032,
        "height": 3024,
        "size": 10,
        "sizet": 5,
        "iLiveVideo": "c4-5-v.mp4",
        "liveSize": 12345,
        "liveDuration": 2.5,
      }],
      "building": True,
      "zoomPoints": {},
    }
    merged = mergeCinfo(fresh, existing)
    image = merged["images"][0]
    gotExpected(image["description"], "Live photo of the plaza")
    gotExpected(image["iLiveVideo"], "c4-5-v.mp4")
    gotExpected(image["liveSize"], 12345)
    gotExpected(image["liveDuration"], 2.5)

  def test_mergeCinfo_preserves_order_and_appends(self):
    existing = {
      "title": "Santa Fe",
      "cNum": 4,
      "images": [
        {"description": "B", "iPreview": "c4-2-p.jpg",
          "iThumbnail": "c4-2-t.jpg", "width": 1, "height": 1,
          "size": 1, "sizet": 1},
        {"description": "A", "iPreview": "c4-1-p.jpg",
          "iThumbnail": "c4-1-t.jpg", "width": 1, "height": 1,
          "size": 1, "sizet": 1},
      ],
    }
    fresh = {
      "title": "",
      "cNum": 4,
      "images": [
        {"description": "", "iPreview": "c4-1-p.jpg",
          "iThumbnail": "c4-1-t.jpg", "width": 1, "height": 1,
          "size": 1, "sizet": 1},
        {"description": "", "iPreview": "c4-2-p.jpg",
          "iThumbnail": "c4-2-t.jpg", "width": 1, "height": 1,
          "size": 1, "sizet": 1},
        {"description": "", "iPreview": "c4-3-p.jpg",
          "iThumbnail": "c4-3-t.jpg", "width": 1, "height": 1,
          "size": 1, "sizet": 1},
      ],
      "building": True,
      "zoomPoints": {},
    }
    merged = mergeCinfo(fresh, existing)
    gotExpected([image["iPreview"] for image in merged["images"]],
      ["c4-2-p.jpg", "c4-1-p.jpg", "c4-3-p.jpg"])
    gotExpected(merged["images"][0]["description"], "B")
    gotExpected(merged["images"][1]["description"], "A")
    gotExpected(merged["images"][2]["description"], "")

  def test_mergeCinfo_drops_missing_preview(self):
    existing = {
      "title": "Santa Fe",
      "cNum": 4,
      "images": [
        {"description": "Keep", "iPreview": "c4-1-p.jpg",
          "iThumbnail": "c4-1-t.jpg", "width": 1, "height": 1,
          "size": 1, "sizet": 1},
        {"description": "Gone", "iPreview": "c4-9-p.jpg",
          "iThumbnail": "c4-9-t.jpg", "width": 1, "height": 1,
          "size": 1, "sizet": 1},
      ],
    }
    fresh = {
      "title": "",
      "cNum": 4,
      "images": [
        {"description": "", "iPreview": "c4-1-p.jpg",
          "iThumbnail": "c4-1-t.jpg", "width": 1, "height": 1,
          "size": 1, "sizet": 1},
      ],
      "building": True,
      "zoomPoints": {},
    }
    merged = mergeCinfo(fresh, existing)
    gotExpected(len(merged["images"]), 1)
    gotExpected(merged["images"][0]["description"], "Keep")

  def test_merge_real_c4_keeps_descriptions(self):
    folder = "dist/images/c4"
    path = os.path.join(folder, "c4.json")
    if not os.path.exists(path):
      return
    existing = loadExistingCinfo(path)
    fileInfoList = getFileInfoList(folder)
    ftg = FileTypeGroups(fileInfoList)
    previewImageInfoList = getImageInfoList(folder, ftg.previews, previews=True)
    fresh = createCollectionCinfo(4, ftg, previewImageInfoList, folder)
    merged = mergeCinfo(fresh, existing)
    gotExpected(merged["title"], existing["title"])
    gotExpected(merged["description"], existing["description"])
    gotExpected(merged["indexDescription"], existing["indexDescription"])
    oldByPreview = {image["iPreview"]: image for image in existing["images"]}
    for image in merged["images"]:
      old = oldByPreview.get(image["iPreview"])
      if old is None:
        continue
      gotExpected(image["description"], old["description"])

  def test_mergeCinfo_keeps_location_when_exif_empty(self):
    existing = {
      "title": "Santa Fe",
      "cNum": 4,
      "images": [{
        "description": "Deck photo",
        "iPreview": "c4-1-p.jpg",
        "iThumbnail": "c4-1-t.jpg",
        "width": 4032,
        "height": 3024,
        "size": 10,
        "sizet": 5,
        "location": "35.6488944,-105.9176778",
        "taken": "2025-06-21T18:25:30",
      }],
    }
    fresh = {
      "title": "",
      "cNum": 4,
      "images": [{
        "description": "",
        "iPreview": "c4-1-p.jpg",
        "iThumbnail": "c4-1-t.jpg",
        "width": 4032,
        "height": 3024,
        "size": 10,
        "sizet": 5,
        "location": "",
        "taken": "",
      }],
      "building": True,
      "zoomPoints": {},
    }
    merged = mergeCinfo(fresh, existing)
    gotExpected(merged["images"][0]["location"], "35.6488944,-105.9176778")
    gotExpected(merged["images"][0]["taken"], "2025-06-21T18:25:30")

def writeTestJpeg(path):
  """ Write a tiny jpeg with no GPS. """
  img = Image.new("RGB", (8, 8), "white")
  img.save(path, "JPEG")

class TestAddLocations(unittest.TestCase):

  def test_dmsToDecimal_hawaii(self):
    lat = dmsToDecimal((20.0, 44.0, 53.99), "N")
    lng = dmsToDecimal((156.0, 27.0, 27.55), "W")
    gotExpected(round(lat, 7), 20.7483306)
    gotExpected(round(lng, 7), -156.4576528)

  def test_dmsToDecimal_south_east(self):
    lat = dmsToDecimal((33.0, 51.0, 54.0), "S")
    lng = dmsToDecimal((151.0, 12.0, 36.0), "E")
    gotExpected(round(lat, 7), -33.8650000)
    gotExpected(round(lng, 7), 151.2100000)

  def test_dmsToDecimal_missing(self):
    gotExpected(dmsToDecimal(None, "N"), None)
    gotExpected(dmsToDecimal((20.0, 44.0, 53.99), None), None)
    gotExpected(dmsToDecimal((20.0, 44.0), "N"), None)
    gotExpected(dmsToDecimal((20.0, 44.0, 53.99), "X"), None)

  def test_dmsToDecimal_invalid_parts(self):
    from PIL.TiffImagePlugin import IFDRational
    gotExpected(dmsToDecimal((IFDRational(0, 0), 0, 0), "N"), None)
    gotExpected(dmsToDecimal((float("nan"), 0.0, 0.0), "N"), None)
    gotExpected(dmsToDecimal(("x", 0.0, 0.0), "N"), None)

  def test_formatGoogleMapsLocation(self):
    gotExpected(
      formatGoogleMapsLocation(20.748330555555558, -156.45765277777775),
      "20.7483306,-156.4576528")
    gotExpected(formatGoogleMapsLocation(None, -156.4), "")
    gotExpected(formatGoogleMapsLocation(20.7, None), "")

  def test_locationFromGps_empty(self):
    gotExpected(locationFromGps({}), "")
    gotExpected(locationFromGps(None), "")

  def test_locationFromGps_named(self):
    gps = {
      1: "N",
      2: (20.0, 44.0, 53.99),
      3: "W",
      4: (156.0, 27.0, 27.55),
    }
    gotExpected(locationFromGps(gps), "20.7483306,-156.4576528")

  def test_locationFromGps_nan(self):
    gps = {
      1: "N",
      2: (float("nan"), float("nan"), float("nan")),
      3: "W",
      4: (float("nan"), float("nan"), float("nan")),
    }
    gotExpected(locationFromGps(gps), "")

  def test_addLocations_missing_preview_is_empty(self):
    folder = tempfile.mkdtemp()
    try:
      preview = os.path.join(folder, "c1-1-p.jpg")
      writeTestJpeg(preview)
      cinfo = {
        "cNum": 1,
        "images": [
          {"iPreview": "c1-1-p.jpg"},
        ],
      }
      cinfo, metadata = addLocations(cinfo, folder)
      gotExpected(cinfo["images"][0]["location"], "")
      gotExpected(cinfo["images"][0]["taken"], "")
      gotExpected(metadata["c1-1-p.jpg"]["location"], "")
      gotExpected(metadata["c1-1-p.jpg"]["taken"], "")
    finally:
      os.remove(preview)
      os.rmdir(folder)

  def test_addLocations_unreadable_preview_is_empty(self):
    folder = tempfile.mkdtemp()
    try:
      good = os.path.join(folder, "c1-1-p.jpg")
      bad = os.path.join(folder, "c1-2-p.jpg")
      writeTestJpeg(good)
      with open(bad, "w") as fh:
        fh.write("not a jpeg")
      cinfo = {
        "cNum": 1,
        "images": [
          {"iPreview": "c1-1-p.jpg"},
          {"iPreview": "c1-2-p.jpg"},
        ],
      }
      cinfo, metadata = addLocations(cinfo, folder)
      gotExpected(cinfo["images"][0]["location"], "")
      gotExpected(cinfo["images"][1]["location"], "")
      gotExpected(cinfo["images"][1]["taken"], "")
      gotExpected(metadata["c1-2-p.jpg"]["location"], "")
    finally:
      os.remove(good)
      os.remove(bad)
      os.rmdir(folder)

  def test_metadataFromPreview_frame_grabber_gps(self):
    preview = "tmp/c36/c36-6-p.jpg"
    if not os.path.isfile(preview):
      self.skipTest(f"missing {preview}")
    gotExpected(metadataFromPreview(preview)["location"], "")
    gotExpected(metadataFromPreview(preview)["taken"], "")

  def test_addLocations_missing_file_errors(self):
    folder = tempfile.mkdtemp()
    try:
      cinfo = {
        "images": [{"iPreview": "c1-1-p.jpg"}],
      }
      try:
        addLocations(cinfo, folder)
        assert False, "Unexpectedly passed"
      except MakerException as ex:
        gotExpected(
          str(ex),
          f"Error: preview file not found: {os.path.join(folder, 'c1-1-p.jpg')}")
    finally:
      os.rmdir(folder)

  def test_formatTaken(self):
    gotExpected(formatTaken("2023:06:04 19:04:44"), "2023-06-04T19:04:44")
    gotExpected(formatTaken("2025:01:20 07:02:41"), "2025-01-20T07:02:41")
    gotExpected(formatTaken(""), "")
    gotExpected(formatTaken(None), "")
    gotExpected(formatTaken("not a date"), "")
    gotExpected(formatTaken(b"2023:06:04 19:04:44"), "2023-06-04T19:04:44")

  def test_addLocations_real_preview_with_gps(self):
    preview = "dist/images/c1/c1-1-p.jpg"
    if not os.path.isfile(preview):
      self.skipTest(f"missing {preview}")
    loc = locationFromPreview(preview)
    self.assertTrue(loc)
    latStr, lngStr = loc.split(",")
    lat = float(latStr)
    lng = float(lngStr)
    self.assertTrue(48 < lat < 49)
    self.assertTrue(-114 < lng < -113)

  def test_addLocations_real_preview_without_gps(self):
    preview = "dist/images/c18/c18-1-p.jpg"
    if not os.path.isfile(preview):
      self.skipTest(f"missing {preview}")
    loc = locationFromPreview(preview)
    if loc:
      self.skipTest(f"{preview} has GPS")
    gotExpected(loc, "")
    gotExpected(metadataFromPreview(preview)["taken"], "")

  def test_addLocations_real_preview_with_time(self):
    preview = "dist/images/c1/c1-1-p.jpg"
    if not os.path.isfile(preview):
      self.skipTest(f"missing {preview}")
    gotExpected(metadataFromPreview(preview)["taken"], "2023-06-04T19:04:44")

if __name__ == '__main__':
  args = parseCommandLine()
  if args.test:
    sys.exit(unittest.main())
  rc = main(args)
  sys.exit(rc)
