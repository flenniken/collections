#!/usr/bin/python3

# This is the help text shown with -h:

"""
Validate a collection folder and write its cjson file.

Pass a folder named like tmp/c24. The files must already use standard
names (c24-1-p.jpg, c24-1-t.jpg, optional c24-1-v.mp4). Maker writes
tmp/c24/c24.json and leaves the folder in place.

When c24.json already exists, titles, descriptions, image order, and
other editorial fields are kept. Width, height, size, live-video,
GPS, and capture-time fields are refreshed from the files. If nothing
changed, the json file is left alone.

See collection-maker.md for the full workflow.

Example:
  scripts/maker tmp/c24
"""

import os

if not os.environ.get("coder_env"):
  print("Run from the Collection's docker environment.")
  exit(1)

# Check that this script is run from the collections folder
cwd = os.getcwd()
if not cwd.endswith("collections"):
  print(f"""\
Run from the collections folder:
cd ~/collections
scripts/maker tmp/c24
""")
  exit(1)

import sys
import argparse
import traceback
import sys
import signal
import unittest
import tempfile
import json
import sys
import re
import textwrap
from boto_client import getBotoClient, getAwsSettings
import random
import string
import shutil
import struct
from PIL import Image, ImageOps
from PIL.ExifTags import GPSTAGS
import math
import glob

thumbnailDim = 480
previewLongMin = 933
previewShortMin = 700

COLLECTION_RE = re.compile(r"^c(\d+)$")
DIGITS_RE = re.compile(r"(\d+)")

# True when the internet connection is working.
internet = True

class MakerException(Exception):
  """ An exception we plan for. """
  pass

def collectionPrefix(folder):
  """
  Return (prefix, number) from a folder named like tmp/c24.
  """
  name = os.path.basename(os.path.abspath(folder))
  match = COLLECTION_RE.fullmatch(name)
  if not match:
    raise MakerException(
      f"Folder name must be a collection like c24, got: {name}")
  return name, int(match.group(1))

def naturalKey(text):
  """
  Return a sort key that orders 2 before 10.
  """
  parts = DIGITS_RE.split(text)
  key = []
  for part in parts:
    if part.isdigit():
      key.append((1, int(part)))
    else:
      key.append((0, part.lower()))
  return key

class FileInfo(object):
  """
  File information important for a Collection.
  """
  def __init__(self, basename, isFile, size):
    self.basename = basename
    self.isFile = isFile
    self.size = size
  def __str__(self):
    isFileStr = "file" if self.isFile else "-"
    return f"{isFileStr:4} {self.size:8} {self.basename}"

def getFileInfoList(folder):
  """
  Return information about each file in a folder.
  """
  fileInfoList = []
  for entry in os.scandir(folder):
    stats = entry.stat()
    fileInfo = FileInfo(
      entry.name,
      entry.is_file(),
      stats.st_size,
    )
    fileInfoList.append(fileInfo)
  # Sort the fileInfoList by basename.
  fileInfoList.sort(key=lambda x: x.basename)
  return fileInfoList

class FileTypeGroups(object):
  """
  Holds the file information for a collection folder organized by
  the file type.
  """
  def __init__(self, fileInfoList):
    self.previews = []
    self.thumbnails = []
    self.liveVideos = []
    self.jsonFiles = []
    self.htmlFilesI = []
    self.htmlFilesT = []
    self.other = []
    for fileInfo in fileInfoList:
      filename = os.path.basename(fileInfo.basename)
      if filename.endswith("-p.jpg"):
        self.previews.append(fileInfo)
      elif filename.endswith("-t.jpg"):
        self.thumbnails.append(fileInfo)
      elif filename.endswith("-v.mp4"):
        self.liveVideos.append(fileInfo)
      elif filename.endswith(".json"):
        self.jsonFiles.append(fileInfo)
      elif filename.startswith("image-") and filename.endswith(".html"):
        self.htmlFilesI.append(fileInfo)
      elif filename.startswith("thumbnails-") and filename.endswith(".html"):
        self.htmlFilesT.append(fileInfo)
      else:
        self.other.append(fileInfo)

class ImageInfo(object):
  """
  Holds the information about an image file that is important for
  a collection.
  """
  def __init__(self, width, height, kind):
    self.width = width
    self.height = height
    self.kind = kind

  @classmethod
  def fromFile(cls, filename):
    """
    Create an ImageInfo object from a file.
    """
    try:
        with Image.open(filename) as img:
          kind = img.format

          # Apply EXIF orientation so width/height match what you see
          transposed_img = ImageOps.exif_transpose(img)
          width, height = transposed_img.size

          # Close the transposed image if it's a new object.
          if transposed_img is not img:
            transposed_img.close()

          return cls(width, height, kind)
    except Exception as ex:
        raise MakerException(f"Error: unable to open the image file: {filename}")

  def __str__(self):
    return f"{self.kind} ({self.width} x {self.height})"

def getImageInfoList(folder, fileInfoList, previews=True):
  """
  Return the image information as a list of ImageInfo objects.
  Previews is True when the fileInfoList is for previews, False
  when it is for thumbnails. If the image is the wrong size or
  not a jpg, raise an exception.
  """
  imageInfoList = []

  for ix, fileInfo in enumerate(fileInfoList):
    fullPath = os.path.join(folder, fileInfo.basename)
    ii = ImageInfo.fromFile(fullPath)
    if ii.kind != "JPEG":
      raise MakerException(f"""\
Error: image must be a jpg.
file: {ii.kind} ({ii.width} x {ii.height}) {fullPath}
""")
    if previews:
      longSide = max(ii.width, ii.height)
      shortSide = min(ii.width, ii.height)
      if longSide < previewLongMin or shortSide < previewShortMin:
        raise MakerException(
          f"""\
Error: preview must be at least {previewLongMin} on one side and {previewShortMin} on the other.
file: ({ii.width} x {ii.height}) {fileInfo.basename}
"""
        )
    else:
      if ii.width != thumbnailDim or ii.height != thumbnailDim:
        raise MakerException(
          f"""\
Error: thumbnail must be square ({thumbnailDim} x {thumbnailDim}).
file: ({ii.width} x {ii.height}) {fileInfo.basename}
"""
        )
    imageInfoList.append(ii)
  return imageInfoList

def validateCollectionFolder(num, ftg):
  """
  Validate that the given files work as a collection. Num is the
  collection number. No files are read.
  """
  numPreviews = len(ftg.previews)
  numThumbnails = len(ftg.thumbnails)
  numLiveVideos = len(ftg.liveVideos)
  numJson = len(ftg.jsonFiles)
  numHtmlI = len(ftg.htmlFilesI)
  numHtmlT = len(ftg.htmlFilesT)
  numOther = len(ftg.other)

  if numPreviews == 0:
    raise MakerException(f"Error: no previews files that end in -p.jpg.")
  if numThumbnails == 0:
    raise MakerException(f"Error: no thumbnails files that end in -t.jpg.")

  if numPreviews != len(ftg.thumbnails):
    raise MakerException(
      f"Error: mismatch: {numPreviews} previews != {numThumbnails} thumbnails.")
  allowedCounts = (8, 10, 12, 14, 16)
  if numThumbnails not in allowedCounts:
    raise MakerException(
      f"Error: {numThumbnails} images, collections must have 8, 10, 12, 14, or 16.")
  if numLiveVideos > numPreviews:
    raise MakerException(
      f"Error: {numLiveVideos} live videos, expected at most {numPreviews}.")
  previewStems = set()
  for fileInfo in ftg.previews:
    stem = pairingStem(fileInfo.basename, "-p.jpg")
    if stem:
      previewStems.add(stem)
  thumbStems = set()
  for fileInfo in ftg.thumbnails:
    stem = pairingStem(fileInfo.basename, "-t.jpg")
    if stem:
      thumbStems.add(stem)
  missingThumbs = sorted(previewStems - thumbStems, key=naturalKey)
  if missingThumbs:
    raise MakerException(
      f"Error: no thumbnail for {missingThumbs[0]}-p.jpg")
  extraThumbs = sorted(thumbStems - previewStems, key=naturalKey)
  if extraThumbs:
    raise MakerException(
      f"Error: thumbnail {extraThumbs[0]}-t.jpg has no matching preview")
  for fileInfo in ftg.liveVideos:
    stem = pairingStem(fileInfo.basename, "-v.mp4")
    if stem not in previewStems:
      raise MakerException(
        f"Error: live video {fileInfo.basename} has no matching {stem}-p.jpg")
  if numJson > 1:
    raise MakerException(f"Error: {numJson} json files, expected 1.")
  if numJson == 1:
    fileInfo = ftg.jsonFiles[0]
    if fileInfo.basename != f"c{num}.json":
      raise MakerException(f"Error: invalid cjson name for this collection: {fileInfo.basename}")

  if numHtmlI > 1:
    raise MakerException(f"Error: {numHtmlI} image html files, expected 1.")
  if numHtmlI == 1:
    fileInfo = ftg.htmlFilesI[0]
    if fileInfo.basename != f"image-{num}.html" :
        raise MakerException(
          f"Error: invalid image html name for this collection: {fileInfo.basename}")

  if numHtmlT > 1:
    raise MakerException(f"Error: {numHtmlT} thumbnails html files, expected 1.")
  if numHtmlT == 1:
    fileInfo = ftg.htmlFilesT[0]
    if fileInfo.basename != f"thumbnails-{num}.html":
        raise MakerException(
          f"Error: invalid thumbnails html name for this collection: {fileInfo.basename}")

  if numOther:
    for other in ftg.other:
      # Ignore the hidden files.
      if other.basename.startswith("."):
        numOther =- 1
        continue
      first = other.basename
      raise MakerException(
        f"Error: there are {numOther} extra files in the folder, first: {first}")

googleMapsDecimals = 7
dateTimeTag = 306
dateTimeOriginalTag = 36867
dateTimeDigitizedTag = 36868
exifIfdTag = 0x8769

def dmsToDecimal(dms, ref):
  """
  Convert an EXIF GPS DMS triple to a signed decimal degree.

  dms is (degrees, minutes, seconds). ref is N/S for latitude or
  E/W for longitude. South and west are negative, matching Google Maps.
  """
  if dms is None or ref is None:
    return None
  if len(dms) != 3:
    return None
  try:
    degrees, minutes, seconds = [float(part) for part in dms]
  except (TypeError, ValueError, ZeroDivisionError):
    return None
  if not all(math.isfinite(part) for part in (degrees, minutes, seconds)):
    return None
  decimal = degrees + minutes / 60.0 + seconds / 3600.0
  if ref in ("S", "W"):
    decimal = -decimal
  elif ref not in ("N", "E"):
    return None
  return decimal

def formatGoogleMapsLocation(lat, lng):
  """
  Return the Google Maps query string "lat,lng", or "" if either
  coordinate is missing.
  """
  if lat is None or lng is None:
    return ""
  return f"{lat:.{googleMapsDecimals}f},{lng:.{googleMapsDecimals}f}"

def gpsFromExif(exif):
  """
  Return the GPS IFD dict from a Pillow Exif object, or {} if none.
  """
  if exif is None:
    return {}
  try:
    gps = exif.get_ifd(0x8825)
  except Exception:
    return {}
  if not gps:
    return {}
  return gps

def locationFromGps(gps):
  """
  Convert a GPS IFD dict to a Google Maps location string, or "".
  """
  if not gps:
    return ""
  named = {GPSTAGS.get(key, key): value for key, value in gps.items()}
  lat = dmsToDecimal(named.get("GPSLatitude"), named.get("GPSLatitudeRef"))
  lng = dmsToDecimal(named.get("GPSLongitude"), named.get("GPSLongitudeRef"))
  return formatGoogleMapsLocation(lat, lng)

def formatTaken(raw):
  """
  Convert an EXIF datetime string to ISO local time, or "".

  EXIF stores "2023:06:04 19:04:44". The result is
  "2023-06-04T19:04:44" with no timezone so the camera's clock time
  is preserved when displayed.
  """
  if not raw:
    return ""
  if isinstance(raw, bytes):
    raw = raw.decode("ascii", "replace")
  raw = str(raw).strip().rstrip("\x00")
  match = re.match(
    r"^(\d{4}):(\d{2}):(\d{2}) (\d{2}):(\d{2}):(\d{2})", raw)
  if not match:
    return ""
  return (f"{match.group(1)}-{match.group(2)}-{match.group(3)}"
          f"T{match.group(4)}:{match.group(5)}:{match.group(6)}")

def takenFromExif(exif):
  """
  Return the capture time from EXIF, or "".

  Prefers DateTimeOriginal, then DateTimeDigitized, then DateTime.
  """
  if exif is None:
    return ""
  try:
    exifIfd = exif.get_ifd(exifIfdTag)
  except Exception:
    exifIfd = {}
  raw = None
  if exifIfd:
    raw = (exifIfd.get(dateTimeOriginalTag)
           or exifIfd.get(dateTimeDigitizedTag))
  if not raw:
    raw = exif.get(dateTimeTag)
  return formatTaken(raw)

def metadataFromPreview(previewPath):
  """
  Return location and taken strings from a preview jpg.
  Missing or unreadable values are "".
  """
  try:
    with Image.open(previewPath) as img:
      exif = img.getexif()
      return {
        "location": locationFromGps(gpsFromExif(exif)),
        "taken": takenFromExif(exif),
      }
  except Exception:
    return {"location": "", "taken": ""}

def locationFromPreview(previewPath):
  """
  Return the Google Maps location string from a preview jpg, or "".
  """
  return metadataFromPreview(previewPath)["location"]

def previewPaths(folder):
  """
  Return sorted preview file paths (*-p.jpg) in the collection folder.
  """
  paths = glob.glob(os.path.join(folder, "*-p.jpg"))
  paths.sort()
  return paths

def addLocations(cinfo, folder):
  """
  Add location and taken fields to each image in cinfo from preview
  EXIF.

  folder is the collection folder containing the *-p.jpg files.
  Returns (cinfo, metadata) where metadata maps iPreview basename
  to {location, taken}.
  """
  if "images" not in cinfo:
    raise MakerException("Error: collection json is missing the images list.")

  metadata = {}
  for previewPath in previewPaths(folder):
    basename = os.path.basename(previewPath)
    metadata[basename] = metadataFromPreview(previewPath)

  for image in cinfo["images"]:
    iPreview = image.get("iPreview")
    if not iPreview:
      raise MakerException("Error: image is missing iPreview.")
    previewPath = os.path.join(folder, iPreview)
    if not os.path.isfile(previewPath):
      raise MakerException(f"Error: preview file not found: {previewPath}")
    imageMeta = metadata.get(iPreview, {"location": "", "taken": ""})
    image["location"] = imageMeta["location"]
    image["taken"] = imageMeta["taken"]

  return cinfo, metadata

def createCollectionCinfo(num, ftg, previewImageInfoList, folder):
  """
  Create the collection info (cinfo) for the given collection number.
  Image names in the json match the files on disk.
  """
  assert len(ftg.previews) == len(ftg.thumbnails)
  videosByStem = liveVideosByPreviewStem(ftg)
  thumbsByStem = {}
  for fileInfo in ftg.thumbnails:
    stem = pairingStem(fileInfo.basename, "-t.jpg")
    if stem is None:
      continue
    if stem in thumbsByStem:
      raise MakerException(f"Error: duplicate thumbnail stem: {stem}")
    thumbsByStem[stem] = fileInfo

  previews = sorted(ftg.previews, key=lambda item: naturalKey(item.basename))
  infoByName = {fileInfo.basename: info
    for fileInfo, info in zip(ftg.previews, previewImageInfoList)}

  images = []

  for fileInfo in previews:
    stem = pairingStem(fileInfo.basename, "-p.jpg")
    thumbnailFileInfo = thumbsByStem.get(stem)
    if thumbnailFileInfo is None:
      raise MakerException(
        f"Error: no thumbnail for {fileInfo.basename}")
    previewImageInfo = infoByName[fileInfo.basename]

    collectionImage = {}
    collectionImage['description'] = ""

    collectionImage['iPreview'] = fileInfo.basename
    collectionImage['iThumbnail'] = thumbnailFileInfo.basename
    collectionImage['width'] = previewImageInfo.width
    collectionImage['height'] = previewImageInfo.height
    collectionImage['size'] = fileInfo.size

    collectionImage['sizet'] = thumbnailFileInfo.size
    meta = metadataFromPreview(os.path.join(folder, fileInfo.basename))
    collectionImage['location'] = meta['location']
    collectionImage['taken'] = meta['taken']
    liveVideoFileInfo = liveVideoForPreview(fileInfo, videosByStem)
    if liveVideoFileInfo:
      collectionImage['iLiveVideo'] = liveVideoFileInfo.basename
      collectionImage['liveSize'] = liveVideoFileInfo.size
      duration = mp4DurationSeconds(
        os.path.join(folder, liveVideoFileInfo.basename))
      if duration is not None:
        collectionImage['liveDuration'] = round(duration, 3)
    images.append(collectionImage)

  # Create the collection info (cinfo). Disk order is the collection
  # order. Empty text is filled in later in place.
  cinfo = {
    "title": "",
    "indexDescription": "",
    "description": "",
    "cNum": num,
    "posted": "",
    "images": images,
    "building": True,
    "zoomPoints": {},
  }
  return cinfo

IMAGE_FILE_KEYS = (
  "iPreview", "iThumbnail", "width", "height", "size", "sizet",
)
LIVE_FILE_KEYS = ("iLiveVideo", "liveSize", "liveDuration")

def loadExistingCinfo(path):
  """
  Return the collection json at path, or None when the file is missing.
  """
  if not os.path.isfile(path):
    return None
  try:
    with open(path, encoding="utf-8") as fh:
      data = json.load(fh)
  except json.JSONDecodeError as ex:
    raise MakerException(f"Error: cannot read existing json: {path}: {ex}")
  if not isinstance(data, dict):
    raise MakerException(
      f"Error: existing json is not a collection object: {path}")
  if "images" in data and not isinstance(data["images"], list):
    raise MakerException(
      f"Error: existing json images is not a list: {path}")
  return data

def mergeImage(old, fresh):
  """
  Keep editorial fields from old and take file-derived fields from fresh.
  """
  merged = dict(old)
  for key in IMAGE_FILE_KEYS:
    merged[key] = fresh[key]
  for key in LIVE_FILE_KEYS:
    if key in fresh:
      merged[key] = fresh[key]
    else:
      merged.pop(key, None)
  for key in ("location", "taken"):
    freshValue = fresh.get(key, "")
    if freshValue:
      merged[key] = freshValue
    elif key in old:
      merged[key] = old[key]
    else:
      merged[key] = ""
  return merged

def mergeCinfo(fresh, existing):
  """
  Keep titles, descriptions, order, zoom points, and other editorial
  fields from existing. File-derived image fields come from fresh.
  New previews are appended. Previews that disappeared are dropped.
  """
  merged = dict(existing)
  merged["cNum"] = fresh["cNum"]
  freshByPreview = {image["iPreview"]: image for image in fresh["images"]}
  images = []
  seen = set()
  for old in existing.get("images", []):
    preview = old.get("iPreview")
    freshImage = freshByPreview.get(preview)
    if freshImage is None:
      continue
    images.append(mergeImage(old, freshImage))
    seen.add(preview)
  for freshImage in fresh["images"]:
    if freshImage["iPreview"] not in seen:
      images.append(freshImage)
  merged["images"] = images
  return merged

def writeCinfo(path, cinfo):
  """
  Write collection json with the usual formatting.
  """
  with open(path, "w", encoding="utf-8") as fh:
    fh.write(json.dumps(cinfo, indent=2, ensure_ascii=False))
    fh.write("\n")

def getStdImageName(num, ix, kind):
  if kind == 'preview':
    prefix = 'p'
  elif kind == 'thumbnail':
    prefix = 't'
  else:
    raise MakerException(f"Invalid kind, expected preview or thumbnail.")

  name = f"c{num}-{ix+1}-{prefix}.jpg"
  return name

def _mp4Atoms(fh, end):
  while fh.tell() + 8 <= end:
    start = fh.tell()
    hdr = fh.read(8)
    if len(hdr) < 8:
      return
    size, typ = struct.unpack(">I4s", hdr)
    if size == 1:
      if fh.tell() + 8 > end:
        return
      size = struct.unpack(">Q", fh.read(8))[0]
    elif size == 0:
      size = end - start
    if size < 8:
      return
    payloadStart = fh.tell()
    atomEnd = start + size
    if atomEnd > end:
      return
    yield typ, payloadStart, atomEnd
    fh.seek(atomEnd)

def _mp4Duration(fh, end):
  for typ, payloadStart, atomEnd in _mp4Atoms(fh, end):
    if typ == b"moov":
      found = _mp4Duration(fh, atomEnd)
      if found is not None:
        return found
    elif typ == b"mvhd":
      fh.seek(payloadStart)
      versionFlags = fh.read(4)
      if len(versionFlags) < 4:
        return None
      if versionFlags[0] == 1:
        fh.read(16)
        tsDur = fh.read(12)
        if len(tsDur) < 12:
          return None
        timescale = struct.unpack(">I", tsDur[:4])[0]
        duration = struct.unpack(">Q", tsDur[4:12])[0]
      else:
        fh.read(8)
        tsDur = fh.read(8)
        if len(tsDur) < 8:
          return None
        timescale, duration = struct.unpack(">II", tsDur)
      if timescale <= 0:
        return None
      return duration / timescale
  return None

def mp4DurationSeconds(path):
  """
  Return the movie duration in seconds from an mp4, or None.
  """
  try:
    fileEnd = os.path.getsize(path)
    with open(path, "rb") as fh:
      return _mp4Duration(fh, fileEnd)
  except OSError:
    return None

def pairingStem(filename, suffix):
  """
  Return the shared name used to pair a preview, thumbnail, or live
  video, e.g. "10" from "10-p.jpg" or "10-v.mp4".
  """
  if filename.endswith(suffix):
    return filename[:-len(suffix)]
  return None

def liveVideosByPreviewStem(ftg):
  """
  Return a dict of live video FileInfo keyed by the matching preview
  stem.
  """
  videosByStem = {}
  for fileInfo in ftg.liveVideos:
    stem = pairingStem(fileInfo.basename, "-v.mp4")
    if stem is None:
      continue
    if stem in videosByStem:
      raise MakerException(f"Error: duplicate live video stem: {stem}")
    videosByStem[stem] = fileInfo
  return videosByStem

def liveVideoForPreview(previewFileInfo, videosByStem):
  """
  Return the live video that shares a stem with the preview, or None.
  """
  stem = pairingStem(previewFileInfo.basename, "-p.jpg")
  if stem is None:
    return None
  return videosByStem.get(stem)

def keyExists(s3Client, bucket_name, key):
  """
  Return true when the file exists in the s3 bucket else return false.
  """
  try:
    s3Client.head_object(Bucket=bucket_name, Key=key)
    return True
  except Exception:
    return False

def new(folder):
  """
  Validate the collection folder and write its cjson file. Leave the
  folder in place.
  """
  if not os.path.isdir(folder):
    raise MakerException(f"Missing the collection folder: {folder}")

  prefix, num = collectionPrefix(folder)

  # Get names and info of all the files in the folder and validate
  # that they work in a collection.
  fileInfoList = getFileInfoList(folder)
  ftg = FileTypeGroups(fileInfoList)
  validateCollectionFolder(num, ftg)

  # Validate the image dimensions and return the preview image information.
  previewImageInfoList = getImageInfoList(folder, ftg.previews, previews=True)
  getImageInfoList(folder, ftg.thumbnails, previews=False)

  cinfo = createCollectionCinfo(num, ftg, previewImageInfoList, folder)
  cjsonFilename = os.path.join(folder, f"{prefix}.json")
  existing = loadExistingCinfo(cjsonFilename)
  if existing is not None:
    cinfo = mergeCinfo(cinfo, existing)
    if cinfo == existing:
      print(f"Unchanged {cjsonFilename}")
      return
  writeCinfo(cjsonFilename, cinfo)
  gpsCount = sum(1 for image in cinfo["images"] if image.get("location"))
  takenCount = sum(1 for image in cinfo["images"] if image.get("taken"))
  print(f"Wrote {cjsonFilename} ({gpsCount} with GPS, {takenCount} with time)")

def parseCommandLine():
  """
  Parse the command line arguments.
  """
  if len(sys.argv) == 1:
    # When there are no arguments provided, show the help information.
    sys.argv.append("-h")
  else:
    # When -t is provided, change argv so unittest does not see it.
    for ix, arg in enumerate(sys.argv[1:]):
      if arg in ['-t', '--test']:
        sys.argv.pop(ix+1)
        args = argparse.Namespace(test=True)
        return args

  # Use this module's comment at the top of the file for the
  # description.
  parser = argparse.ArgumentParser(
  prog='maker', formatter_class=argparse.RawDescriptionHelpFormatter,
  description=textwrap.dedent(__doc__))

  parser.add_argument("-t", "--test", action="store_true",
    help="""run internal unit tests""")
  parser.add_argument("folder",
    help="collection folder, e.g. tmp/c24")

  args = parser.parse_args(sys.argv[1:])

  # Note: when -t is specified, the code doesn't reach this point.

  if "help" in args and args.help:
    parser.print_help()
    sys.exit(1)

  return args

def process(args):
  """
  Handle the maker command's options.
  """
  if args.folder:
    new(args.folder)

def main(args):
  def signalHandler(sig, frame):
    """ Handle ctrl-C """
    sys.exit(1)
  signal.signal(signal.SIGINT, signalHandler)
  try:
    process(args)
  except KeyboardInterrupt:
    print("\nStopping")
  except MakerException as ex:
    print(str(ex))
  except Exception as ex:
    print("Unexpected exception")
    print(traceback.format_exc())
    return 1
  return 0 # success

# Test code:

def testGetCollectionImagesError(previews, thumbnails, eMessage):
  """
  Test getCollectionImages errors, pass in the expected error message.
  """
  try:
    getCollectionImages(1, previews, thumbnails)
    assert False, "Unexpectedly passed"
  except MakerException as ex:
    gotExpected(str(ex), eMessage)
    return # passed
  assert False, "Got an unexpected exception."

def gotExpected(got, expected):
  if got != expected:
    msg = f"""
---
     got: {got}
expected: {expected}
---
"""
    assert False, msg

def pv(name, value):
  print(f"{name}: {value}")

def fail(msg):
  assert 0 == 1, msg

def testGetImageInfoError(filename, eMsg):
  """
  Test getImageInfo errors, pass in the expected error message.
  """
  try:
    ImageInfo.fromFile(filename)
    fail("Unexpectedly passed")
  except MakerException as ex:
    gotExpected(str(ex), eMsg)
    return # passed
  fail("Got an unexpected exception.")

def testValidateFolderError(num, previews=8, thumbnails=8, cjson=0,
      imageHtml=0, thumbnailHtml=0, others=0, eMsg=""):
  try:
    folder = makeTestFolder(num, previews=previews, thumbnails=thumbnails,
      cjson=cjson, imageHtml=imageHtml, thumbnailHtml=thumbnailHtml, others=others)
    fileInfoList = getFileInfoList(folder)
  finally:
    shutil.rmtree(folder)

  ftg = FileTypeGroups(fileInfoList)

  try:
    validateCollectionFolder(num, ftg)
  except MakerException as ex:
    gotExpected(str(ex), eMsg)
    return # passed
  fail("Got an unexpected exception.")

def randomName(folder, k=6, prefix="", postfix=""):
  """
  Return a random name in the given folder with the
  given prefix and postfix.
  """
  randomPart = random62(k)
  return os.path.join(folder, f"{prefix}{randomPart}{postfix}")

def random62(k):
  """
  Return a random base 62 number of the given length.
  """
  characters = string.ascii_letters + string.digits
  return ''.join(random.choices(characters, k=k))

def createFile(filename, contents):
  """ Create a new file with the given contents. """
  with open(filename, 'w+', encoding='utf-8') as fh:
    fh.write(contents)

def makeTestFolder(num, previews=8, thumbnails=8, cjson=1,
  imageHtml=1, thumbnailHtml=1, others=0):
  """
  Make a collection folder in the temp dir for testing. Return the
  folder name.  When done with the folder delete it with:
  shutil.rmtree(folder)
  """

  # Create a temp folder and fill it with the specified number of fake
  # small files.

  folder = tempfile.mkdtemp(prefix="maker-")

  for ix in range(previews):
    filename = os.path.join(folder, f"c{num}-{ix+1}-p.jpg")
    createFile(filename, f"fake preview file {'a' * ix}")

  for ix in range(thumbnails):
    filename = os.path.join(folder, f"c{num}-{ix+1}-t.jpg")
    createFile(filename, f"fake thumbnail file {'b' * ix}")

  for ix in range(cjson):
    filename = os.path.join(folder, f"c{num+ix}.json")
    createFile(filename, f"fake cjson file {'c' * ix}")

  for ix in range(imageHtml):
    filename = os.path.join(folder, f"image-{num+ix}.html")
    createFile(filename, f"fake image html file {'d' * ix}")

  for ix in range(thumbnailHtml):
    filename = os.path.join(folder, f"thumbnails-{num+ix}.html")
    createFile(filename, f"fake thumbnail html file {'e' * ix}")

  for ix in range(others):
    filename = os.path.join(folder, f"other-{ix}.txt")
    createFile(filename, f"fake other file {'f' * ix}")

  return folder

def getTestImageInfoList(previews):
  """
  Return a list of preview image information for testing. The information is made up.
  """
  imageInfoList = []
  for ix, fileInfo in enumerate(previews):
    imageInfoList.append(ImageInfo(previewLongMin+ix, previewLongMin+ix, "JPEG"))
  return imageInfoList

