  def test_liveVideoPairedByStem(self):
    # 2 has no video; 10 does. Pair by stem, not by list index, and
    # keep the names already on disk.
    num = 21
    folder = tempfile.mkdtemp(prefix="maker-")
    try:
      for i in (1, 2, 3, 10):
        createFile(os.path.join(folder, f"{i}-p.jpg"), f"p{i}")
        createFile(os.path.join(folder, f"{i}-t.jpg"), f"t{i}")
      for i in (1, 3, 10):
        createFile(os.path.join(folder, f"{i}-v.mp4"), f"v{i}" * 10)
      ftg = FileTypeGroups(getFileInfoList(folder))
      previewImageInfoList = getTestImageInfoList(ftg.previews)
      cinfo = createCollectionCinfo(num, ftg, previewImageInfoList, folder)
      gotExpected(cinfo["images"][0]["iPreview"], "1-p.jpg")
      gotExpected(cinfo["images"][0]["iLiveVideo"], "1-v.mp4")
      gotExpected(cinfo["images"][1]["iPreview"], "2-p.jpg")
      gotExpected("iLiveVideo" in cinfo["images"][1], False)
      gotExpected(cinfo["images"][2]["iPreview"], "3-p.jpg")
      gotExpected(cinfo["images"][2]["iLiveVideo"], "3-v.mp4")
      gotExpected(cinfo["images"][3]["iPreview"], "10-p.jpg")
      gotExpected(cinfo["images"][3]["iLiveVideo"], "10-v.mp4")
    finally:
      shutil.rmtree(folder)

